#!/bin/bash
# Prevents direct pushes to main.
# All changes must go through a feature branch and pull request.

while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo ""
        echo "❌ Direct push to main is not allowed."
        echo ""
        echo "   All changes must go through a pull request:"
        echo "   1. Work on a feature branch"
        echo "   2. Push the branch: git push origin <branch-name>"
        echo "   3. Open a PR on GitHub for review"
        echo "   4. Merge only after review"
        echo ""
        exit 1
    fi
done

exit 0
